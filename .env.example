# Core app secrets — required
JWT_SECRET=<64-character hex string>
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
# Name must match exactly — the code reads PUBLISHABLE_KEY, not ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable/anon key>
# Server-side only; bypasses RLS. Required by lib/supabase/service.ts.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Amazon SP-API (pricing/listings — used by Price Change Plans and other SKU pricing lookups)
# Separate from the ADS_* credentials below.
#
# SP-API is partitioned into three regions, each with its own host, refresh token
# and seller account. One LWA app serves all three, so CLIENT_ID/CLIENT_SECRET are
# shared while the token and seller id are per region:
#
#   NA  US, CA, MX                        -> the unsuffixed vars below
#   EU  GB, DE, FR, IT, ES, NL, BE, IE,
#       SE, PL, AE, SA                    -> *_EU
#   FE  AU                                -> *_FE
#
# There is deliberately NO fallback from a regional var to the NA one: handing a
# North America token to a European host is exactly the failure this split exists
# to prevent. A missing var raises an error naming the variable.
CLIENT_ID=<LWA client id>
CLIENT_SECRET=<LWA client secret>

# North America (US / CA / MX)
REFRESH_TOKEN=<refresh token with pricing/listings scope>
SELLER_ID=<Amazon seller id — Seller Central > Account Info > Merchant Token>

# Europe — only needed once an EU marketplace is switched to live
REFRESH_TOKEN_EU=<EU refresh token>
SELLER_ID_EU=<EU merchant token>

# Far East (Australia) — only needed once AU is switched to live
REFRESH_TOKEN_FE=<AU refresh token>
SELLER_ID_FE=<AU merchant token>

# Amazon Advertising API (Sponsored Brands Upload -> "Upload to Amazon")
# Separate from SP-API creds above. Refresh token needs the advertising::campaign_management scope.
# Without these, "Download bulk file" still works; "Upload to Amazon" surfaces a clear error.
ADS_CLIENT_ID=<LWA client id>
ADS_CLIENT_SECRET=<LWA client secret>
ADS_REFRESH_TOKEN=<refresh token with advertising::campaign_management scope>

# Titan/GoDaddy company mailbox (Communications -> Company Inbox).
# Same credentials are used for both IMAP read and SMTP send/reply. Host/port for
# both (imap.secureserver.net:993, smtpout.secureserver.net:465) are hardcoded in
# lib/actions/mail.ts. Without these, the Company Inbox page shows a clear
# "not configured" error instead of failing silently.
TITAN_IMAP_USER=<mailbox address>
TITAN_IMAP_PASSWORD=<mailbox password>

# Yahoo Mail company mailbox (Communications -> Company Inbox), second mailbox
# alongside Titan above — same account-registry mechanism in lib/actions/mail.ts.
# IMPORTANT: Yahoo requires a *Yahoo App Password* here, not the account's normal
# sign-in password, whenever 2FA is enabled — generate one from Yahoo Account
# Security settings ("Generate app password").
# Without these, the Yahoo toggle still appears (staff can see the mailbox
# exists) but selecting it surfaces a clear "cs_shoplala@yahoo.com email is not
# configured" error instead of failing silently.
YAHOO_IMAP_USER=<mailbox address, e.g. cs_shoplala@yahoo.com>
YAHOO_IMAP_PASSWORD=<Yahoo App Password — NOT the normal account password>

# Price Change Plans -> "Update now" button.
# The portal can't write prices to Amazon (lib/amazon/sp-api.ts is read-only) and the
# pricing worker publishes no port, so the call is relayed through an n8n webhook.
# The secret must match the n8n Header Auth credential on header X-Portal-Secret.
# Without these, plans still step on the nightly cron; only the button errors.
N8N_PRICE_STEP_WEBHOOK_URL=https://<your-n8n-host>/webhook/price-step
N8N_WEBHOOK_SECRET=<openssl rand -hex 32>